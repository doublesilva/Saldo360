# Exemplo de configuração local. Copie para .env e troque os valores.
# O arquivo .env é ignorado pelo git — nunca versione credenciais reais.
POSTGRES_DB=saldo360
POSTGRES_USER=saldo360
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Laboratório Pluggy (T09.1) - POC somente leitura, apenas local.
PLUGGY_ENABLED=false
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_IMPORT_ENABLED=false
