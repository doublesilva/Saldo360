# Copie para /srv/saldo360-deploy/.env e mantenha fora do Git.
POSTGRES_DB=saldo360
POSTGRES_USER=saldo360
POSTGRES_PASSWORD=troque-esta-senha-forte

# Porta publicada apenas no loopback do home-server; o Caddy é a entrada HTTPS.
SALDO360_WEB_PORT=5600

# Origem escolhida para produção.
SALDO360_PUBLIC_HOST=saldo360.home.doublesilva.com

# Obrigatoriamente um SHA Git completo. O deploy sobrescreve este exemplo com o SHA publicado.
SALDO360_IMAGE_TAG=0000000000000000000000000000000000000000

# Liberação controlada do pipeline de contas de serviço. Permanecem desligadas por padrão.
FINANCIAL_DOCUMENT_CLASSIFICATION_ENABLED=false
FINANCIAL_DOCUMENT_CLASSIFICATION_AGENT_ENABLED=false
SERVICE_BILL_EXTRACTION_ENABLED=false
SERVICE_BILL_EXTRACTION_AGENT_ENABLED=false
SERVICE_BILL_RECONCILIATION_ENABLED=false
SERVICE_BILL_CONFIRMATION_ENABLED=false
SERVICE_BILL_BINDING_ENABLED=false

# Secret HMAC dedicado (32 bytes Base64) instalado fora do repositório e da imagem:
# /etc/saldo360/secrets/service-account-identifier-hmac-key, root:1654 0640.
# API e migrate recebem mount read-only; Production recusa inicialização sem chave válida.
