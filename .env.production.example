# Copie para /srv/saldo360-deploy/.env e mantenha fora do Git.
POSTGRES_DB=saldo360
POSTGRES_USER=saldo360
POSTGRES_PASSWORD=troque-esta-senha-forte

# Opcional no primeiro deploy. Preencher APENAS com o ID retornado pelo bootstrap
# autenticado. Sem valor, não há perfis de coleta; preenchê-lo NÃO habilita coleta.
FINANCIAL_WORKSPACE_ID=

# Porta publicada apenas no loopback do home-server; o Caddy é a entrada HTTPS.
SALDO360_WEB_PORT=5600

# Origem escolhida para produção.
SALDO360_PUBLIC_HOST=saldo360.home.doublesilva.com

# Obrigatoriamente um SHA Git completo. O deploy sobrescreve este exemplo com o SHA publicado.
SALDO360_IMAGE_TAG=0000000000000000000000000000000000000000

# Agente de IA (classificação de lançamentos): preparação não autoriza ativação. Nunca colocar a chave neste arquivo.
AI_AGENT_ENABLED=false
AI_AGENT_MODEL=gpt-4o-mini

# OPCIONAL, somente para conversão explicitamente aprovada de base legada populada.
# Instalação vazia não precisa dessa variável. Não restaurar um plano legado após reset.
FINANCIAL_WORKSPACE_CUTOVER_PLAN=
