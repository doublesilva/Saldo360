{
  "//": "Exemplo das chaves esperadas pela API. NÃO coloque valores reais de segredos em appsettings.*.json: use user-secrets (desenvolvimento), variáveis de ambiente (ConnectionStrings__Saldo360, Authentication__Oidc__ClientSecret) ou um arquivo de segredo (Authentication__Oidc__ClientSecretFile). Valores entre <> dependem do ambiente.",
  "ConnectionStrings": {
    "Saldo360": "Host=localhost;Port=5432;Database=saldo360;Username=saldo360;Password=<sua-senha>"
  },
  "Authentication": {
    "Oidc": {
      "Authority": "https://auth.home.doublesilva.com",
      "ClientId": "saldo360",
      "ClientSecret": "<client-secret-do-provedor, ou use ClientSecretFile>",
      "ClientSecretFile": "/run/secrets/<arquivo-com-o-segredo-do-client>",
      "Scopes": [ "openid", "profile", "email" ],
      "CallbackPath": "/signin-oidc",
      "BackchannelCaCertificatePath": "/usr/local/share/ca-certificates/caddy-local-root.crt"
    },
    "Session": {
      "CookieName": "__Host-saldo360.session",
      "IdleTimeout": "08:00:00"
    }
  },
  "ReverseProxy": {
    "KnownProxies": [ "<ip-do-proxy>" ],
    "KnownNetworks": [ "<rede-do-proxy-em-cidr, ex.: 172.20.0.0/16>" ],
    "AllowedHosts": [ "<host-publico-do-saldo360>" ]
  },
  "FinancialDocuments": {
    "StoragePath": "<diretorio-privado-persistente>"
  },
  "FinancialEmailImport": {
    "Enabled": false,
    "Provider": "Gmail",
    "LookbackDays": 30,
    "MaxMessages": 50,
    "Gmail": {
      "Mailbox": "",
      "ClientId": "",
      "ClientSecret": "",
      "RefreshToken": ""
    },
    "Sources": [
      {
        "Name": "Bills",
        "FamilyId": "00000000-0000-0000-0000-000000000000",
        "Query": "has:attachment filename:pdf",
        "Enabled": false
      }
    ]
  }
}
