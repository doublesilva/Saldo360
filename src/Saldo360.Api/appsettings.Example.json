{
  "//": "Exemplo das chaves esperadas pela API. NÃO coloque valores reais de segredos em appsettings.*.json: use user-secrets (desenvolvimento) ou variáveis de ambiente (ConnectionStrings__Saldo360, Authentication__Oidc__ClientSecret).",
  "ConnectionStrings": {
    "Saldo360": "Host=localhost;Port=5432;Database=saldo360;Username=saldo360;Password=<sua-senha>"
  },
  "Authentication": {
    "Oidc": {
      "Authority": "https://auth.exemplo.com.br",
      "ClientId": "saldo360",
      "ClientSecret": "<client-secret-do-provedor>",
      "Scopes": [ "openid", "profile", "email" ],
      "CallbackPath": "/signin-oidc",
      "BackchannelCaCertificatePath": null
    },
    "Session": {
      "CookieName": "__Host-saldo360.session",
      "IdleTimeout": "08:00:00"
    }
  }
}
